<DOMDocument xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://ns.adobe.com/xfl/2008/" frameRate="24.000000" width="450.000000" height="450.000000" xflVersion="2.971">
  <folders>
    <DOMFolderItem name="media"/>
    <DOMFolderItem name="image"/>
    <DOMFolderItem name="sprite"/>
    <DOMFolderItem name="label"/>
  </folders>
  <media>
    <DOMBitmapItem name="media/giantpea_base" href="media/giantpea_base.png"/>
    <DOMBitmapItem name="media/giantpea_highlight" href="media/giantpea_highlight.png"/>
    <DOMBitmapItem name="media/giantpea_shadow" href="media/giantpea_shadow.png"/>
  </media>
  <symbols>
    <Include href="image/giantpea_base.xml"/>
    <Include href="image/giantpea_highlight.xml"/>
    <Include href="image/giantpea_shadow.xml"/>
    <Include href="sprite/sprite_1.xml"/>
    <Include href="sprite/sprite_2.xml"/>
    <Include href="sprite/sprite_3.xml"/>
    <Include href="label/animation.xml"/>
  </symbols>
  <timelines>
    <DOMTimeline name="animation">
      <layers>
        <DOMLayer name="label">
          <frames>
            <DOMFrame index="0" duration="20" name="animation" labelType="name">
              <elements/>
            </DOMFrame>
          </frames>
        </DOMLayer>
        <DOMLayer name="action">
          <frames>
            <DOMFrame index="0" duration="19">
              <elements/>
            </DOMFrame>
            <DOMFrame index="19">
              <Actionscript>
                <script><![CDATA[stop();]]></script>
              </Actionscript>
              <elements/>
            </DOMFrame>
          </frames>
        </DOMLayer>
        <DOMLayer name="instance">
          <frames>
            <DOMFrame index="0" duration="20">
              <elements>
                <DOMSymbolInstance libraryItemName="label/animation" symbolType="graphic" loop="loop"/>
              </elements>
            </DOMFrame>
          </frames>
        </DOMLayer>
      </layers>
    </DOMTimeline>
  </timelines>
</DOMDocument>